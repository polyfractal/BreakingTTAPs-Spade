use lib::tta::Move;
use lib::tta::Src;
use lib::tta::Dst;
use lib::tta::Instr;
use lib::sram;


//============================================================
// IMEM (Instruction Memory)
// - 1024 instructions max
// - Each instruction has 2x32b move words (slot0, slot1)
// - Token map is hardcoded for simplicity
//============================================================

// ---------- Move decode ----------
//
// Move word (uint<32>):
// [31]      guard
// [30:24]   src_tok   (7 bits, 0..127)
// [23:17]   dst_tok   (7 bits, 0..127)
// [15:0]    imm16
//
// ------------------------------------------------------

fn decode_src_tok(t: uint<8>, imm16: uint<16>) -> Src {
    match t {
        // RF[0..7]
        00u8 => Src::RegisterFile(0u4),   // TODO this is dumb, use immediate for the register index?
        01u8 => Src::RegisterFile(1u4),
        02u8 => Src::RegisterFile(2u4),
        03u8 => Src::RegisterFile(3u4),
        04u8 => Src::RegisterFile(4u4),
        05u8 => Src::RegisterFile(5u4),
        06u8 => Src::RegisterFile(6u4),
        07u8 => Src::RegisterFile(7u4),

        08u8 => Src::Zero,
        09u8 => Src::PC_Val,

        // Immediate
        10u8 => Src::Immediate(zext(imm16)),

        // FU results
        11u8 => Src::ALU_Res,
        12u8 => Src::LSU_Res,
        13u8 => Src::Cmp_Res,
        14u8 => Src::Cmpz_Res,
        15u8 => Src::LALU_Res,
        16u8 => Src::MUL_Res,
        17u8 => Src::CC_Res_Lo,
        18u8 => Src::CC_Res_High,
        19u8 => Src::Xorshift_Res,
        20u8 => Src::SEL_Res,
        21u8 => Src::MDA_Res,
        22u8 => Src::TNH_Res,
        23u8 => Src::DIV_Res,
        24u8 => Src::MAC_Res,
        25u8 => Src::Stack_Res,
        26u8 => Src::LSU2_Res,
        27u8 => Src::BIT_Res,

        // External Inputs
        60u8 => Src::GPI_In,
        61u8 => Src::UART_In,
        62u8 => Src::SPI_In8,

        // RF[8..15]
        100u8 => Src::RegisterFile(8u4),
        101u8 => Src::RegisterFile(9u4),
        102u8 => Src::RegisterFile(10u4),
        103u8 => Src::RegisterFile(11u4),
        104u8 => Src::RegisterFile(12u4),
        105u8 => Src::RegisterFile(13u4),
        106u8 => Src::RegisterFile(14u4),
        107u8 => Src::RegisterFile(15u4),

        110u8 => Src::PC_Next,

        // Reserved bands for future FUs
        _ => Src::Zero
    }
}

fn decode_dst_tok(t: uint<8>) -> Dst {
    match t {
        // RF[0..7]
        00u8 => Dst::RegisterFile(0u4),
        01u8 => Dst::RegisterFile(1u4),
        02u8 => Dst::RegisterFile(2u4),
        03u8 => Dst::RegisterFile(3u4),
        04u8 => Dst::RegisterFile(4u4),
        05u8 => Dst::RegisterFile(5u4),
        06u8 => Dst::RegisterFile(6u4),
        07u8 => Dst::RegisterFile(7u4),

        // Jump if true
        // Missing mappings from v1.0
        08u8 => Dst::BT_Target,
        09u8 => Dst::BT_Trig,

        // ALU
        10u8 => Dst::ALU_OpA,
        11u8 => Dst::ALU_Add_Trig,
        12u8 => Dst::ALU_Sub_Trig,
        13u8 => Dst::ALU_And_Trig,
        14u8 => Dst::ALU_Or_Trig,
        15u8 => Dst::ALU_Shl_Trig,
        16u8 => Dst::ALU_Shr_Trig,
        17u8 => Dst::ALU_Ashr_Trig,
        18u8 => Dst::ALU_Rotl_Trig ,
        19u8 => Dst::ALU_Rotr_Trig ,

        // LSU
        20u8 => Dst::LSU_AddrA,
        21u8 => Dst::LSU_Load_Trig,
        22u8 => Dst::LSU_Store_Trig,

        // Cmp
        23u8 => Dst::Cmp_Eq_Trig,
        24u8 => Dst::Cmp_Neq_Trig,
        25u8 => Dst::Cmp_Slt_Trig,
        26u8 => Dst::Cmp_Sle_Trig,
        27u8 => Dst::Cmp_Ult_Trig,
        28u8 => Dst::Cmp_Ule_Trig,

        // Xorshift32 PRNG
        29u8 => Dst::Xorshift_Trig,

        // PC
        30u8 => Dst::PC_Trig,

        // Cmpz
        31u8 => Dst::Cmpz_Eqz_Trig,
        32u8 => Dst::Cmpz_Neqz_Trig,
        33u8 => Dst::Cmpz_Sltz_Trig,
        34u8 => Dst::Cmpz_Slez_Trig,
        35u8 => Dst::Cmpz_Sgtz_Trig,
        36u8 => Dst::Cmpz_Sgez_Trig,

        // Lightweight ALU
        37u8 => Dst::LALU_OpA,
        38u8 => Dst::LALU_Add_Trig,
        39u8 => Dst::LALU_Sub_Trig,

        // Shift-Add Multiplier
        40u8 => Dst::MUL_AddrA,
        41u8 => Dst::MUL_Trig,

        // Shift-Sub Division
        42u8 => Dst::DIV_AddrA,
        43u8 => Dst::DIV_Trig,

        // Bit manip
        44u8 => Dst::BIT_Clz_Trig,
        45u8 => Dst::BIT_Ctz_Trig,
        46u8 => Dst::BIT_Popcnt_Trig,
        47u8 => Dst::BIT_Bset_Trig,
        48u8 => Dst::BIT_Bext_Trig,
        49u8 => Dst::BIT_Bins_Trig,
        50u8 => Dst::BIT_Brev_Trig,


        51u8 => Dst::ALU_Min_Trig,
        52u8 => Dst::ALU_Max_Trig,

        // Multiply-and-accumulate
        53u8 => Dst::MAC_AddrA,
        54u8 => Dst::MAC_Trig,
        55u8 => Dst::MAC_Clear,

        // SEL
        56u8 => Dst::SEL_Cond,
        57u8 => Dst::SEL_SetA,
        58u8 => Dst::SEL_TrigB,

        59u8 => Dst::TNH_Trig,

        // Output
        60u8 => Dst::GPO_Out,
        61u8 => Dst::SPI_Out8,

        // Modulo-Add
        62u8 => Dst::MDA_Base,
        63u8 => Dst::MDA_Mask,
        64u8 => Dst::MDA_Ptr,
        65u8 => Dst::MDA_Trig,

        // More ALU lol
        66u8 => Dst::ALU_SSadd_Trig,
        67u8 => Dst::ALU_SSsub_Trig,
        68u8 => Dst::ALU_USadd_Trig,
        69u8 => Dst::ALU_USsub_Trig,

        // Program stack
        70u8 => Dst::Stack_SetA,
        71u8 => Dst::Stack_Push_Trig,
        72u8 => Dst::Stack_Pop_Trig,

        // LSU2
        73u8 => Dst::LSU2_AddrA,
        74u8 => Dst::LSU2_Load_Trig,
        75u8 => Dst::LSU2_Store_Trig,

        // UART TX
        76u8 => Dst::UART_Out8,

        // oops forgot this!
        77u8 => Dst::ALU_Not_Trig,

        78u8 => Dst::UART_InPop_Trig,
        79u8 => Dst::SPI_InPop_Trig,

        // Missing mappings from v1.0
        80u8 => Dst::ALU_Xor_Trig,
        81u8 => Dst::BIT_Bclr_Trig,
        82u8 => Dst::Cmp_OpA,

        100u8 => Dst::RegisterFile(8u4),
        101u8 => Dst::RegisterFile(9u4),
        102u8 => Dst::RegisterFile(10u4),
        103u8 => Dst::RegisterFile(11u4),
        104u8 => Dst::RegisterFile(12u4),
        105u8 => Dst::RegisterFile(13u4),
        106u8 => Dst::RegisterFile(14u4),
        107u8 => Dst::RegisterFile(15u4),

        // Future bands
        _ => Dst::ALU_OpA
    }
}

// Decode the raw bits into a Move struct
fn decode_move(mw: uint<32>) -> Move {
    let guard_bit: uint<1> = trunc((mw >> 31) & 0x1u32);
    let guard: bool = (guard_bit != 0u1);

    let src_tok: uint<8> = trunc((mw >> 24) & 0x7Fu32);
    let dst_tok: uint<8> = trunc((mw >> 17) & 0x7Fu32);
    let imm16:  uint<16> = trunc(mw & 0xFFFFu32);

    let src = decode_src_tok(src_tok, imm16);
    let dst = decode_dst_tok(dst_tok);
    Move(src, dst, guard)
}


fn zero32() -> uint<32> { 0u32 }


pub entity imem(
    clk: clock, rst: bool,

    // run-time fetch
    boot_mode: bool,
    fetch_pc: uint<10>,

    // boot-time writes (pulses when Some)
    wr_addr:  Option<uint<10>>,          // this should all be one combined option/struct
    wr_slot0: Option<uint<32>>,
    wr_slot1: Option<uint<32>>
) -> Option<Instr>
{

    // this set of matches is a little untidy :(
    let (wren, addr_calc) = match wr_addr {
        Some(addr) => (true, addr),     // if we have an address it's a write
        None => (false, fetch_pc)  // otherwise read the program counter address
    };
    let wdata0 = match wr_slot0 {
        Some(instr) => instr,
        None => 0
    };
    let wdata1 = match wr_slot1 {
        Some(instr) => instr,
        None => 0
    };

    reg(clk) rdata0: uint<32> = inst sram::iram_1024x32(clk, rst, addr_calc, wren, wdata0);
    reg(clk) rdata1: uint<32> = inst sram::iram_1024x32(clk, rst, addr_calc, wren, wdata1);


    match wr_addr {
        Some(_) => None,
        None => {
            match boot_mode {
                true => None,
                false => {
                    let mv0 = decode_move(rdata0);
                    let mv1 = decode_move(rdata1);
                    Some(Instr(mv0, mv1))
                }
            }
        }
    }
}
