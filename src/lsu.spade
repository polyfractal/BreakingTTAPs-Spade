use lib::tta::Msg;
use lib::sram;

//============================================
// Load/Store FU (1-cycle visible latency for loads)
// - set_addr_a: base address (32-bit; truncated to 16 for SRAM)
// - load_trig:  compute addr = A + offset on this cycle and perform a LOAD
// - store_trig: write bus value to [A + 0] on this cycle (simple store)
// Returns: Option<uint<32>> valid on the cycle after load_trig (when not a store)
//
// Notes:
// - If both load_trig and store_trig are present, STORE wins and no load is produced.
// - Addressing: load_trig uses its value as B; store uses current A (no offset).
//============================================
pub entity lsu_fu (
  clk: clock, rst: bool,
  set_addr_a: Option<uint<32>>,
  load_trig:  Option<uint<32>>,   // offset B; triggers LOAD
  store_trig: Option<uint<32>>    // store data; triggers STORE
) -> Option<uint<32>>
{
    // base address
    reg(clk) addr_a: uint<32> reset(rst: 0) = match set_addr_a {
        Some(v) => v,
        None    => addr_a
    };

    let addr_calc: uint<33> = match load_trig {
        Some(b) => addr_a + b,
        None => zext(addr_a)
    };

    // Compute address for LOAD when load_trig is present
    let wren: bool = match store_trig { Some(_) => true, None => false };
    let wdata = match store_trig { Some(x) => x, None => 0 };
    let rdata = inst sram::sram_512x32(clk, rst, true, trunc(addr_calc), wren, wdata);

    // Make the load result visible next cycle
    reg(clk) ld_ready: bool reset(rst: false) = match ((load_trig, store_trig)) {
        (Some(_), None) => true,
        (_, Some(_)) => false,
        (None, None) => false
    };

    if ld_ready { Some(rdata) } else { None }
}



// Bus helpers

pub fn pick_lsu_seta(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<32>> {
    match m1 {
        Some(Msg::LSU_SetA(x)) => Some(x),
        _ => match m0 {
            Some(Msg::LSU_SetA(x)) => Some(x),
            _ => None
        }
    }
}

pub fn pick_lsu_loadtrig(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<32>> {
    match m1 {
        Some(Msg::LSU_Load_Trig(x)) => Some(x),
        _ => match m0 {
            Some(Msg::LSU_Load_Trig(x)) => Some(x),
            _ => None
        }
    }
}

pub fn pick_lsu_storetrig(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<32>> {
    match m1 {
        Some(Msg::LSU_Store_Trig(x)) => Some(x),
        _ => match m0 {
            Some(Msg::LSU_Store_Trig(x)) => Some(x),
            _ => None
        } }
}



