use lib::tta::Msg;

//============================================================
// General purpose output
// Pins are directly mapped to bits of `wr` u16
// Outputs are not 2FF synchronized so be careful? I dunno XD
//============================================================

// General purpose output
pub entity gpo16(
  clk: clock, rst: bool,
  wr: Option<uint<16>>
) -> uint<16>              // pins
{
  reg(clk) outv: uint<16> reset(rst: 0u16) =
    match wr {
      Some(v) => v,
      None => outv
    };

  outv
}

// Bus helper
pub fn pick_gpo16(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<16>> {
    match m1 {
        Some(Msg::GPO_Out(x)) => Some(x),
        _ => match m0 {
            Some(Msg::GPO_Out(x)) => Some(x),
            _ => None }
    }
}
