use lib::tta::Msg;

//============================================================
// ALU functional unit
// - Write ALU_OpA to set operand A
// - Write *_Trig (with a value) to trigger operation
// - ALU_Res holds result
// - Latency: 1 Cycle
//============================================================

pub enum AluOp {
    Add, Sub, And, Or, Not, Xor, Shl, Shr, Ashr, Rotl, Rotr, Min,
    Max, SSadd, SSsub, USadd, USsub
}

pub entity alu_fu(
  clk: clock, rst: bool,
  set_op_a: Option<uint<32>>,
  trig:     Option<(AluOp, uint<32>)>
) -> Option<uint<32>>
{
    // operand A
    reg(clk) op_a: uint<32> reset(rst: 0) = match set_op_a {
        Some(v) => v,
        None    => op_a
    };

    // Combinational ALU core
    let result: Option<uint<32>> = match trig {
        // Standard Arithmetic
        Some((AluOp::Add, b)) => Some(trunc(op_a + b)),
        Some((AluOp::Sub, b)) => Some(trunc(op_a - b)),
        Some((AluOp::And, b)) => Some(op_a & b),
        Some((AluOp::Or,  b)) => Some(op_a | b),
        Some((AluOp::Not,  b)) => Some(~b),
        Some((AluOp::Xor, b)) => Some(op_a ^ b),
        Some((AluOp::Shl, b)) => { let sh: uint<32> = trunc(b) & 0x1F; Some(trunc(op_a << sh)) },
        Some((AluOp::Shr, b)) => { let sh: uint<32> = trunc(b) & 0x1F; Some(trunc(op_a >> sh)) },
        Some((AluOp::Ashr, b)) => { let sh: uint<5> = trunc(b); Some(ashr32(op_a, sh)) },
        Some((AluOp::Rotl, b)) => { let sh: uint<5> = trunc(b); Some(rotl32(op_a, sh)) },
        Some((AluOp::Rotr, b)) => { let sh: uint<5> = trunc(b); Some(rotr32(op_a, sh)) },

        // Min / Max (Unsigned)
        Some((AluOp::Min, b)) => Some(if op_a < b { op_a } else { b }),
        Some((AluOp::Max, b)) => Some(if op_a > b { op_a } else { b }),

        // Saturating Arithmetic (Signed)
        Some((AluOp::SSadd, b)) => Some(sadd32(op_a, b)),
        Some((AluOp::SSsub, b)) => Some(ssub32(op_a, b)),

        // Saturating Arithmetic (Unsigned)
        Some((AluOp::USadd, b)) => Some(uadd32(op_a, b)),
        Some((AluOp::USsub, b)) => Some(usub32(op_a, b)),

        None => None
    };

    // Register the result (visible next cycle as ALU_Res)
    reg(clk) res_reg: Option<uint<32>> reset(rst: None) = result;
    res_reg
}


// -----------------------------------------------------------
// Saturating Arithmetic Helpers (Unsigned)
// -----------------------------------------------------------

fn uadd32(a: uint<32>, b: uint<32>) -> uint<32> {
    // Extend to 33 bits to detect overflow beyond 0xFFFFFFFF
    let sum: uint<33> = zext(a) + zext(b);

    // 0x100000000 is the first value that doesn't fit in 32 bits
    if sum > 0xFFFFFFFF {
        0xFFFFFFFF // Clamp to Max Uint
    } else {
        trunc(sum)
    }
}

fn usub32(a: uint<32>, b: uint<32>) -> uint<32> {
    // If a < b, result would wrap (underflow). Clamp to 0 instead.
    if a < b {
        0
    } else {
        trunc(a - b)
    }
}

// -----------------------------------------------------------
// Saturating Arithmetic Helpers (Signed)
// -----------------------------------------------------------

fn sadd32(a_u: uint<32>, b_u: uint<32>) -> uint<32> {
    // Cast to signed
    let a: int<32> = a_u.as_int();
    let b: int<32> = b_u.as_int();

    // Sign extend to 33 bits to capture overflow
    let a_big: int<33> = sext(a);
    let b_big: int<33> = sext(b);
    let sum = a_big + b_big;

    // Check Limits
    // Max Int (32-bit):  2147483647
    // Min Int (32-bit): -2147483648
    if sum > 2147483647 {
        0x7FFFFFFF // Max Positive
    } else if sum < -2147483648 {
        0x80000000 // Max Negative (Min Int)
    } else {
        // Safe to truncate back
        let sum: int<32> = trunc(sum);
        sum.as_uint()
    }
}

fn ssub32(a_u: uint<32>, b_u: uint<32>) -> uint<32> {
    let a: int<32> = a_u.as_int();
    let b: int<32> = b_u.as_int();

    let a_big: int<33> = sext(a);
    let b_big: int<33> = sext(b);
    let diff: int<34> = a_big - b_big;

    if diff > 2147483647 {
        0x7FFFFFFF
    } else if diff < -2147483648 {
        0x80000000
    } else {
        let trunc_diff: int<32> = trunc(diff);
        trunc_diff.as_uint()
    }
}


// 32-bit arithmetic SHIFT RIGHT by a variable amount (ASR)
// sh is masked to 5 bits (0-31) at call site
fn ashr32(x: uint<32>, sh: uint<5>) -> uint<32> {
    let sh32: uint<32> = zext(sh);
    let logical: uint<32> = x >> sh32;
    let sign1: uint<1> = trunc(x >> 31);
    let signmask: uint<32> = 0 - zext(sign1);
    let top_mask: uint<32> = if (sh == 0) { 0 } else { trunc((0 - 1) << (32 - sh32) ) };
    let fill: uint<32> = signmask & top_mask;
    logical | fill
}

// sh is masked to 5 bits (0-31) at call site
fn rotl32(x: uint<32>, sh: uint<5>) -> uint<32> {
  let sh32: uint<32> = zext(sh);
  if (sh == 0) { x } else {
    let left: uint<32> = x << sh32;
    let inverted: uint<32> = trunc(32 - sh32);
    let right: uint<32> = x >> inverted;
    left | right
  }
}

// sh is masked to 5 bits (0-31) at call site
fn rotr32(x: uint<32>, sh: uint<5>) -> uint<32> {
  let sh32: uint<32> = zext(sh);
  if (sh == 0) { x } else {
    let right: uint<32> = x >> sh32;
    let inverted: uint<32> = trunc(32 - sh32);
    let left : uint<32> = x << inverted;
    right | left
  }
}

// Bus Helpers

pub fn pick_alu_seta(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<32>> {
    match m1 {
        Some(Msg::ALU_SetA(x)) => Some(x),
        _ => match m0 {
            Some(Msg::ALU_SetA(x)) => Some(x),
            _ => None }
    }
}

pub fn pick_alu_trig(m0: Option<Msg>, m1: Option<Msg>) -> Option<(AluOp, uint<32>)> {
    match m1 {
        Some(Msg::ALU_Trig(op, x)) => Some((op, x)),
        _ => match m0 {
            Some(Msg::ALU_Trig(op, x)) => Some((op, x)),
            _ => None
        }
    }
}
