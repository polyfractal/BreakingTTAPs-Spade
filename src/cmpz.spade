use lib::tta::Msg;

//============================================================
// cmpz: compare-to-zero with boolean (0/1) result
//
// Signed semantics for SLTZ/SLEZ/SGTZ/SGEZ
// - trigger with RH
// - CMPZ_Res holds boolean comparison against zero
// - Latency: 1 Cycle
//============================================================

pub enum CmpzOp {
    Eqz,     // B == 0
    Neqz,    // B != 0
    Sltz,    // signed B <  0
    Slez,    // signed B <= 0
    Sgtz,    // signed B >  0
    Sgez     // signed B >= 0
}

pub entity cmpz_fu(
  clk: clock, rst: bool,
  trig: Option<(CmpzOp, uint<32>)>
) -> Option<uint<32>>
{
    // Combinational Cmpz core (on current-cycle trigger input)
    let result: Option<uint<32>> = match trig {
        Some((CmpzOp::Eqz, b))   => Some(to_u32(b == 0u32)),
        Some((CmpzOp::Neqz, b))  => Some(to_u32(b != 0u32)),
        Some((CmpzOp::Sltz, b))  => Some(to_u32(msb1(b) == 1u1)),
        Some((CmpzOp::Slez,  b)) => Some(to_u32(msb1(b) == 1u1 || b == 0u32)),
        Some((CmpzOp::Sgtz, b))  => Some(to_u32(msb1(b) != 1u1 && b != 0u32)),
        Some((CmpzOp::Sgez, b))  => Some(to_u32(msb1(b) != 1u1)),
        None                     => None
    };

    // Register the result (visible next cycle as Cmpz_Res)
    reg(clk) res_reg: Option<uint<32>> reset(rst: None) = result;
    res_reg
}

// Bus helper
pub fn pick_cmpz_trig(m0: Option<Msg>, m1: Option<Msg>) -> Option<(CmpzOp, uint<32>)> {
    match m1 {
        Some(Msg::Cmpz_Trig(op, x)) => Some((op, x)),
        _ => match m0 {
            Some(Msg::Cmpz_Trig(op, x)) => Some((op, x)),
            _ => None
        }
    }
}

fn msb1(x: uint<32>) -> uint<1> { trunc((x >> 31) & 1u32) }
fn to_u32(x: bool) -> uint<32> { if x { 1u32 } else { 0u32 } }
