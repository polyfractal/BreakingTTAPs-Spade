use lib::tta::Msg;

//============================================================
// SPI input functional unit
// - Data arriving on SPI is buffered into an 8 slot FIFO
// - pop = true will return a value off the FIFO
// - FIFO will drop values if full
//============================================================

pub entity spi_in(
  clk: clock, rst: bool,
  miso_byte: Option<uint<8>>,
  pop: bool
) -> Option<uint<32>>
{
    // Small FIFO queue to help buffer data
    let data = inst lib::fifo::fifo_u8(clk, rst, miso_byte, pop);
    reg(clk) data: Option<uint<32>> reset(rst: None) = match data {
      Some(b) => Some(zext(b)),
      None => None
    };

  data
}

//============================================================
// SPI output functional unit
// - Data to be written is queued into 8 slot FIFO
// - Data is written when SPI is not busy
// - FIFO will drop values if full
//============================================================


pub entity spi_out8(
  clk: clock, rst: bool,
  byte_to_write: Option<uint<8>> ,
  mosi: inv Option<uint<8>>,
  spi_busy: bool
) -> ()
{
    // Small FIFO queue to help buffer data
    // if miso is_some(), it will get pushed onto the queue
    // if there is any data (including current byte), pop
    let data = inst lib::fifo::fifo_u8(clk, rst, byte_to_write, !spi_busy);   // only pop if SPI is not busy
    reg(clk) data: Option<uint<8>> reset(rst: None) = match data {
      Some(b) => Some(b),
      None => None
    };

    set mosi = data;
}

// Bus helpers

pub fn pick_spi_inpop(m0: Option<Msg>, m1: Option<Msg>) -> bool {
    match m1 {
        Some(Msg::SPI_InPop_Trig) => true,
        _ => match m0 {
            Some(Msg::SPI_InPop_Trig) => true,
            _ => false }
    }
}

pub fn pick_spi_out8(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<8>> {
    match m1 {
        Some(Msg::SPI_Out8(x)) => Some(x),
        _ => match m0 {
            Some(Msg::SPI_Out8(x)) => Some(x),
            _ => None }
    }
}
