
use lib::alu::AluOp;
use lib::bit::BitOp;
use lib::cmp::CmpOp;
use lib::cmpz::CmpzOp;
use lib::lalu::LAluOp;

// Sources you can read on the bus
pub enum Src {
  RegisterFile{idx: uint<4>}, // register file
  ALU_Res,                    // ALU result
  LALU_Res,                   // Lightweight ALU result
  PC_Val,                     // current program counter (before update)
  PC_Next,                    // PC_Val + 1, to help with function calls
  Immediate{val: uint<32>},   // place an immediate constant on the bus
  Zero,                       // constant zero,
  LSU_Res,                    // Load result from LSU1
  LSU2_Res,                   // Load result from LSU2
  GPI_In,                     // General purpose input pins
  UART_In,                    // UART RX
  Cmp_Res,                    // Compare result
  Cmpz_Res,                   // CompareZero result
  MUL_Res,                    // Multiply result
  CC_Res_Lo,                  // Hardware counter low bits
  CC_Res_High,                // hardware counter high bits
  SPI_In8,                    // SPI RX
  DIV_Res,                    // Division result
  Xorshift_Res,               // PRNG result
  MAC_Res,                    // Multiply and Accumulate result
  SEL_Res,                    // Conditional Move result
  MDA_Res,                    // Modulo Add result
  TNH_Res,                    // TanH Result
  Stack_Res,                  // Stack pop result
  BIT_Res,                    // Bit manipulation result
}

// Destinations you can write to the bus
pub enum Dst {
  RegisterFile{idx: uint<4>},
  ALU_OpA,
  ALU_Add_Trig,
  ALU_Sub_Trig,
  ALU_And_Trig,
  ALU_Or_Trig,
  ALU_Not_Trig,
  ALU_Xor_Trig,
  ALU_Shl_Trig,
  ALU_Shr_Trig,
  ALU_Ashr_Trig,
  ALU_Rotl_Trig,
  ALU_Rotr_Trig,
  ALU_Min_Trig,
  ALU_Max_Trig,
  ALU_SSadd_Trig,
  ALU_SSsub_Trig,
  ALU_USadd_Trig,
  ALU_USsub_Trig,

  BIT_Clz_Trig,
  BIT_Ctz_Trig,
  BIT_Popcnt_Trig,
  BIT_Bset_Trig,
  BIT_Bclr_Trig,
  BIT_Bext_Trig,
  BIT_Bins_Trig,
  BIT_Brev_Trig,

  LALU_OpA,
  LALU_Add_Trig,
  LALU_Sub_Trig,

  PC_Trig,                    // write new PC (jump) - triggers next fetch from here

  BT_Target,
  BT_Trig,

  LSU_AddrA,
  LSU_Load_Trig,
  LSU_Store_Trig,

  LSU2_AddrA,
  LSU2_Load_Trig,
  LSU2_Store_Trig,

  GPO_Out,

  Cmp_OpA,
  Cmp_Eq_Trig,
  Cmp_Neq_Trig,
  Cmp_Slt_Trig,
  Cmp_Sle_Trig,
  Cmp_Ult_Trig,
  Cmp_Ule_Trig,

  Cmpz_Eqz_Trig,
  Cmpz_Neqz_Trig,
  Cmpz_Sltz_Trig,
  Cmpz_Slez_Trig,
  Cmpz_Sgtz_Trig,
  Cmpz_Sgez_Trig,

  MUL_AddrA,
  MUL_Trig,

  DIV_AddrA,
  DIV_Trig,

  Xorshift_Trig,

  MAC_AddrA,
  MAC_Trig,
  MAC_Clear,

  SEL_Cond,
  SEL_SetA,
  SEL_TrigB,

  MDA_Base,
  MDA_Mask,
  MDA_Ptr,
  MDA_Trig,

  TNH_Trig,

  Stack_SetA,
  Stack_Push_Trig,
  Stack_Pop_Trig,

  SPI_Out8,
  UART_Out8,
  UART_InPop_Trig,
  SPI_InPop_Trig
}

// One data move scheduled on a bus (optionally executed / guarded)
pub struct Move {
  src:   Src,
  dst:   Dst,
  execute: bool
}

// Instruction word = one move per bus/slot
pub struct Instr {
  slot0: Move,
  slot1: Move
}

pub enum Msg {
    RF_Write{idx: uint<4>, data: uint<32>},
    ALU_SetA{val: uint<32>},
    ALU_Trig{op: AluOp, valB: uint<32>},
    PC_Jump{addr: uint<10>},
    LSU_SetA{val: uint<32>},
    LSU_Load_Trig{val: uint<32>},
    LSU_Store_Trig{val: uint<32>},
    LSU2_SetA{val: uint<32>},
    LSU2_Load_Trig{val: uint<32>},
    LSU2_Store_Trig{val: uint<32>},
    GPO_Out{val: uint<16>},
    Cmp_SetA{val: uint<32>},
    Cmp_Trig{op: CmpOp, valB: uint<32>},
    Cmpz_Trig{op: CmpzOp, valB: uint<32>},
    LALU_SetA{val: uint<32>},
    LALU_Trig{op: LAluOp, valB: uint<32>},
    MUL_SetA{val: uint<32>},
    MUL_Trig{val: uint<32>},
    BT_Target{addr: uint<10>},
    BT_Trig{addr: uint<32>},
    SPI_Out8{addr: uint<8>},
    DIV_SetA{val: uint<32>},
    DIV_Trig{val: uint<32>},
    Xorshift_Trig{val: uint<32>},
    MAC_SetA{val: uint<32>},
    MAC_Trig{val: uint<32>},
    MAC_Clear{val: bool},
    SEL_Cond{val: bool},
    SEL_SetA{val: uint<32>},
    SEL_TrigB{val: uint<32>},
    MDA_Base{val: uint<32>},
    MDA_Mask{val: uint<32>},
    MDA_Ptr{val: uint<32>},
    MDA_Trig{val: uint<32>},
    TNH_Trig{val: uint<32>},
    Stack_SetA{val: uint<32>},
    Stack_Push_Trig{val: uint<32>},
    Stack_Pop_Trig,
    UART_Out8{addr: uint<8>},
    BIT_SetA{val: uint<32>},
    BIT_Trig{op: BitOp, valB: uint<32>},
    UART_InPop_Trig,
    SPI_InPop_Trig,
}

// Decode slot to Msg
fn decode_move(dst: Dst, v: Option<uint<32>>) -> Option<Msg> {
    match (dst, v) {
        (Dst::RegisterFile(i), Some(x)) => Some(Msg::RF_Write(i, x)),

        (Dst::ALU_OpA,         Some(x)) => Some(Msg::ALU_SetA(x)),
        (Dst::ALU_Add_Trig,    Some(x)) => Some(Msg::ALU_Trig(AluOp::Add, x)),
        (Dst::ALU_Sub_Trig,    Some(x)) => Some(Msg::ALU_Trig(AluOp::Sub, x)),
        (Dst::ALU_And_Trig,    Some(x)) => Some(Msg::ALU_Trig(AluOp::And, x)),
        (Dst::ALU_Or_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Or,  x)),
        (Dst::ALU_Not_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Not,  x)),
        (Dst::ALU_Shl_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Shl,  x)),
        (Dst::ALU_Shr_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Shr,  x)),
        (Dst::ALU_Ashr_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Ashr,  x)),
        (Dst::ALU_Rotl_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Rotl,  x)),
        (Dst::ALU_Rotr_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Rotr,  x)),
        (Dst::ALU_Min_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Min,  x)),
        (Dst::ALU_Max_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::Max,  x)),
        (Dst::ALU_SSadd_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::SSadd,  x)),
        (Dst::ALU_SSsub_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::SSsub,  x)),
        (Dst::ALU_USadd_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::USadd,  x)),
        (Dst::ALU_USsub_Trig,     Some(x)) => Some(Msg::ALU_Trig(AluOp::USsub,  x)),

        (Dst::BIT_Clz_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Clz,  x)),
        (Dst::BIT_Ctz_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Ctz,  x)),
        (Dst::BIT_Popcnt_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Popcnt,  x)),
        (Dst::BIT_Bset_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Bset,  x)),
        (Dst::BIT_Bclr_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Bclr,  x)),
        (Dst::BIT_Bext_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Bext,  x)),
        (Dst::BIT_Bins_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Bins,  x)),
        (Dst::BIT_Brev_Trig,     Some(x)) => Some(Msg::BIT_Trig(BitOp::Brev,  x)),

        (Dst::LALU_OpA,         Some(x)) => Some(Msg::LALU_SetA(x)),
        (Dst::LALU_Add_Trig,    Some(x)) => Some(Msg::LALU_Trig(LAluOp::Add, x)),
        (Dst::LALU_Sub_Trig,    Some(x)) => Some(Msg::LALU_Trig(LAluOp::Sub, x)),

        (Dst::PC_Trig,         Some(x)) => Some(Msg::PC_Jump(trunc(x))),

        (Dst::BT_Target,       Some(x)) => Some(Msg::BT_Target(trunc(x))),
        (Dst::BT_Trig,         Some(x)) => Some(Msg::BT_Trig(x)),

        (Dst::LSU_AddrA,       Some(x)) => Some(Msg::LSU_SetA(x)),
        (Dst::LSU_Load_Trig,   Some(x)) => Some(Msg::LSU_Load_Trig(x)),
        (Dst::LSU_Store_Trig,  Some(x)) => Some(Msg::LSU_Store_Trig(x)),

        (Dst::LSU2_AddrA,       Some(x)) => Some(Msg::LSU2_SetA(x)),
        (Dst::LSU2_Load_Trig,   Some(x)) => Some(Msg::LSU2_Load_Trig(x)),
        (Dst::LSU2_Store_Trig,  Some(x)) => Some(Msg::LSU2_Store_Trig(x)),

        (Dst::GPO_Out,         Some(x)) => Some(Msg::GPO_Out(trunc(x))),

        (Dst::Cmp_OpA,         Some(x)) => Some(Msg::Cmp_SetA(x)),
        (Dst::Cmp_Eq_Trig,     Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Eq, x)),
        (Dst::Cmp_Neq_Trig,    Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Neq, x)),
        (Dst::Cmp_Slt_Trig,    Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Slt, x)),
        (Dst::Cmp_Sle_Trig,    Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Sle,  x)),
        (Dst::Cmp_Ult_Trig,    Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Ult,  x)),
        (Dst::Cmp_Ule_Trig,    Some(x)) => Some(Msg::Cmp_Trig(CmpOp::Ule,  x)),

        (Dst::Cmpz_Eqz_Trig,     Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Eqz, x)),
        (Dst::Cmpz_Neqz_Trig,    Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Neqz, x)),
        (Dst::Cmpz_Sltz_Trig,    Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Sltz, x)),
        (Dst::Cmpz_Slez_Trig,    Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Slez,  x)),
        (Dst::Cmpz_Sgtz_Trig,    Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Sgtz,  x)),
        (Dst::Cmpz_Sgez_Trig,     Some(x)) => Some(Msg::Cmpz_Trig(CmpzOp::Sgez,  x)),

        (Dst::MUL_AddrA,       Some(x)) => Some(Msg::MUL_SetA(x)),
        (Dst::MUL_Trig,        Some(x)) => Some(Msg::MUL_Trig(x)),

        (Dst::DIV_AddrA,       Some(x)) => Some(Msg::DIV_SetA(x)),
        (Dst::DIV_Trig,        Some(x)) => Some(Msg::DIV_Trig(x)),

        (Dst::Xorshift_Trig,        Some(x)) => Some(Msg::Xorshift_Trig(x)),

        (Dst::MAC_AddrA,  Some(x)) => Some(Msg::MAC_SetA(x)),
        (Dst::MAC_Trig,   Some(x)) => Some(Msg::MAC_Trig(x)),
        (Dst::MAC_Clear,  Some(x)) => Some(Msg::MAC_Clear(x != 0)),

        (Dst::SEL_Cond,  Some(x)) => Some(Msg::SEL_Cond(x != 0)),
        (Dst::SEL_SetA,   Some(x)) => Some(Msg::SEL_SetA(x)),
        (Dst::SEL_TrigB,  Some(x)) => Some(Msg::SEL_TrigB(x)),

        (Dst::MDA_Base,  Some(x)) => Some(Msg::MDA_Base(x)),
        (Dst::MDA_Mask,  Some(x)) => Some(Msg::MDA_Mask(x)),
        (Dst::MDA_Ptr,  Some(x)) => Some(Msg::MDA_Ptr(x)),
        (Dst::MDA_Trig,  Some(x)) => Some(Msg::MDA_Trig(x)),

        (Dst::TNH_Trig,  Some(x)) => Some(Msg::TNH_Trig(x)),

        (Dst::Stack_SetA,  Some(x)) => Some(Msg::Stack_SetA(x)),
        (Dst::Stack_Push_Trig,  Some(x)) => Some(Msg::Stack_Push_Trig(x)),
        (Dst::Stack_Pop_Trig,  Some(x)) => Some(Msg::Stack_Pop_Trig),

        (Dst::SPI_Out8,        Some(x)) => Some(Msg::SPI_Out8(trunc(x))),
        (Dst::SPI_InPop_Trig,  Some(x)) => Some(Msg::SPI_InPop_Trig),

        (Dst::UART_Out8,        Some(x)) => Some(Msg::UART_Out8(trunc(x))),
        (Dst::UART_InPop_Trig,  Some(x)) => Some(Msg::UART_InPop_Trig),

        _ => None
    }
}

// Most of this is debug output
struct TTA_Tick {
    pc_val: uint<10>,
    alu_a_comb: Option<uint<32>>,
    alu_t_comb: Option<(AluOp, uint<32>)>,
    alu_res: Option<uint<32>>,
    pc_jump_comb: Option<uint<10>>,
    rf_w0: Option<(uint<4>, uint<32>)>,
    rf_w1: Option<(uint<4>, uint<32>)>,
    rd0: uint<32>,
    rd1: uint<32>,
    lsu_res: Option<uint<32>>,
    lsu_set_addr: Option<uint<32>>,
    lsu_store: Option<uint<32>>,
    lsu_load: Option<uint<32>>,
    instruction: Option<Instr>,
    gpo16: uint<16>,
    //state: StateDebug,
}

pub entity tta(clk: clock,
    rst: bool,
    insn: Instr,                // decoded instruction from IMEM
    pc_w: inv uint<10>,         // PC write port
    gpi16: uint<16>,
    uart_rx: Option<uint<8>>,
    uart_tx: inv Option<uint<8>>,
    uart_tx_busy: bool,
    spi_miso: Option<uint<8>>,
    spi_mosi: inv Option<uint<8>>,
    spi_busy: bool,
) -> TTA_Tick
{
    // Note: All the declared values are registered elsewhere
    // Probably needs to be refactored to use ports

    // ---------- Functional Units ----------
    // --- Program Counter
    let (bt_target_r, bt_target_w) = port();

    decl pc_jump_final;
    let pc_val  = inst lib::pc::pc_fu(clk, rst, pc_jump_final, bt_target_r);
    set pc_w = pc_val;   // wire up the PC to external IMEM

    decl bt_target;
    decl bt_trig;
    let bt_val  = inst lib::bt::bt_fu(clk, rst, bt_target, bt_trig);
    set bt_target_w = bt_val;   // wire up the output of branch-if-true to the PC above

    // --- Simple arithmetic
    decl alu_op_a;
    decl alu_trig;
    let alu_res = inst lib::alu::alu_fu(clk, rst, alu_op_a, alu_trig);

    // --- Bit manip
    decl bit_op_a;
    decl bit_trig;
    let bit_res = inst lib::bit::bit_fu(clk, rst, bit_op_a, bit_trig);

    // --- Lightweight ALU (only add/sub)
    decl lalu_op_a;
    decl lalu_trig;
    let lalu_res = inst lib::lalu::lalu_fu(clk, rst, lalu_op_a, lalu_trig);

    // --- Shift-Add Multiplier
    decl mul_set_addr;
    decl mul_trig;
    let mul_res = inst lib::mul_shiftadd::mul_shiftadd_fu(clk, rst, mul_set_addr, mul_trig);

    // --- Shift-Sub Division
    decl div_set_addr;
    decl div_trig;
    let div_res = inst lib::div_shiftsub::div_shiftsub_fu(clk, rst, div_set_addr, div_trig);

    // --- Compare
    decl cmp_op_a;
    decl cmp_trig;
    let cmp_res = inst lib::cmp::cmp_fu(clk, rst, cmp_op_a, cmp_trig);

    // --- CompareZ
    decl cmpz_trig;
    let cmpz_res = inst lib::cmpz::cmpz_fu(clk, rst, cmpz_trig);

    // --- Load/Store
    decl lsu_set_addr;
    decl lsu_load_trig;
    decl lsu_store_trig;
    let lsu_res = inst lib::lsu::lsu_fu(clk, rst, lsu_set_addr, lsu_load_trig, lsu_store_trig);

    // --- Load/Store Second Instance
    decl lsu2_set_addr;
    decl lsu2_load_trig;
    decl lsu2_store_trig;
    let lsu2_res = inst lib::lsu::lsu_fu(clk, rst, lsu2_set_addr, lsu2_load_trig, lsu2_store_trig);

    // --- TanH
    decl tanh_trig;
    let tanh_res = inst lib::tanh::tanh_pwl_fu(clk, rst, tanh_trig);

    // --- Clock Counter
    let (cc_res_lo, cc_res_high) = inst lib::cc::cc_fu(clk, rst);

    // --- Xorshift PRNG
    decl xorshift_trig;
    let xorshift_res = inst lib::xorshift::xorshift_fu(clk, rst, xorshift_trig);

    // --- MAC
    decl mac_set_addr;
    decl mac_trig;
    decl mac_clear;
    let mac_res = inst lib::mac::mac_fu(clk, rst, mac_set_addr, mac_trig, mac_clear);

    // --- SEL
    decl sel_cond;
    decl sel_seta;
    decl sel_trigb;
    let sel_res = inst lib::sel::sel_fu(clk, rst, sel_cond, sel_seta, sel_trigb);

    // --- Modulo Add
    decl mda_base;
    decl mda_mask;
    decl mda_ptr;
    decl mda_trig;
    let mda_res = inst lib::modadd::modadd_fu(clk, rst, mda_base, mda_mask, mda_ptr, mda_trig);

    // --- Program Stack
    decl stack_setaddr;
    decl stack_push;
    decl stack_pop;
    let stack_res = inst lib::stack_lsu::stack_lsu_fu(clk, rst, stack_setaddr, stack_pop, stack_push);

    // --- General purpose output pins
    decl gpo_trig;
    let gpo_res = inst lib::gpo::gpo16(clk, rst, gpo_trig);

    // --- General purpose input pins
    let gpi_res = inst lib::gpi::gpi16(clk, rst, gpi16);

    // --- UART input data
    decl uart_inpop_trig;
    let uart_in_res = inst lib::uart_in::uart_in(clk, rst, uart_rx, uart_inpop_trig);
    decl uart_out8_trig;
    let _ = inst lib::uart_in::uart_out(clk, rst, uart_out8_trig, uart_tx, uart_tx_busy);

    // --- SPI IO
    decl spi_inpop_trig;
    let spi_in_res = inst lib::spi::spi_in(clk, rst, spi_miso, spi_inpop_trig);
    decl spi_out8_trig;
    let _ = inst lib::spi::spi_out8(clk, rst, spi_out8_trig, spi_mosi, spi_busy);

    // --- Register file
    // Extract register file read indices for both slots (default 0 when not used)
    // TODO register handling is bad
    let ra0: uint<4> = match insn.slot0.src { Src::RegisterFile(i) => i, _ => 0 }; //todo return results should be Options
    let ra1: uint<4> = match insn.slot1.src { Src::RegisterFile(i) => i, _ => 0 };

    decl rf_w0;
    decl rf_w1;
    let registry = inst lib::regfile::regfile8_fu(clk, rst, rf_w0, rf_w1, ra0, ra1);

    // ---------- Build bus values ----------

    let bus0_val_opt: Option<uint<32>> =
        if insn.slot0.execute {
            match insn.slot0.src {
                Src::RegisterFile(_)   => Some(registry.rd0),
                Src::PC_Val  => Some(zext(pc_val)),
                Src::PC_Next  => Some(zext(pc_val + 1)),
                Src::Immediate(v)  => Some(v),
                Src::Zero    => Some(0),
                Src::ALU_Res => alu_res,
                Src::LSU_Res => lsu_res,
                Src::LSU2_Res => lsu2_res,
                Src::GPI_In  => gpi_res,
                Src::UART_In => uart_in_res,
                Src::Cmp_Res => cmp_res,
                Src::Cmpz_Res => cmpz_res,
                Src::LALU_Res => lalu_res,
                Src::MUL_Res => mul_res,
                Src::CC_Res_Lo => Some(cc_res_lo),
                Src::CC_Res_High => Some(cc_res_high),
                Src::SPI_In8 => spi_in_res,
                Src::DIV_Res => div_res,
                Src::Xorshift_Res => xorshift_res,
                Src::MAC_Res => mac_res,
                Src::SEL_Res => sel_res,
                Src::MDA_Res => mda_res,
                Src::TNH_Res => tanh_res,
                Src::Stack_Res => stack_res,
                Src::BIT_Res => bit_res,
            }
        } else { None };

    let bus1_val_opt: Option<uint<32>> =
        if insn.slot1.execute {
            match insn.slot1.src {
                Src::RegisterFile(_)   => Some(registry.rd1),
                Src::PC_Val  => Some(zext(pc_val)),
                Src::PC_Next  => Some(zext(pc_val + 1)),
                Src::Immediate(v)  => Some(v),
                Src::Zero    => Some(0),
                Src::ALU_Res => alu_res,
                Src::LSU_Res => lsu_res,
                Src::LSU2_Res => lsu2_res,
                Src::GPI_In  => gpi_res,
                Src::UART_In => uart_in_res,
                Src::Cmp_Res => cmp_res,
                Src::Cmpz_Res => cmpz_res,
                Src::LALU_Res => lalu_res,
                Src::MUL_Res => mul_res,
                Src::CC_Res_Lo => Some(cc_res_lo),
                Src::CC_Res_High => Some(cc_res_high),
                Src::SPI_In8 => spi_in_res,
                Src::DIV_Res => div_res,
                Src::Xorshift_Res => xorshift_res,
                Src::MAC_Res => mac_res,
                Src::SEL_Res => sel_res,
                Src::MDA_Res => mda_res,
                Src::TNH_Res => tanh_res,
                Src::Stack_Res => stack_res,
                Src::BIT_Res => bit_res,
            }
        } else { None };

    // ---------- Decode each slot to a single message ----------
    let m0 = decode_move(insn.slot0.dst, bus0_val_opt);
    let m1 = decode_move(insn.slot1.dst, bus1_val_opt);

    // ---------- Route messages to units ----------
    // RF can accept two writes; map m0->wr0 and m1->wr1 when applicable.
    let rf_w0 = lib::regfile::route_rf_one(m0);
    let rf_w1 = lib::regfile::route_rf_one(m1);

    let alu_op_a = lib::alu::pick_alu_seta(m0, m1);
    let alu_trig = lib::alu::pick_alu_trig(m0, m1);

    let bit_op_a = lib::bit::pick_bit_seta(m0, m1);
    let bit_trig = lib::bit::pick_bit_trig(m0, m1);

    let lalu_op_a = lib::lalu::pick_lalu_seta(m0, m1);
    let lalu_trig = lib::lalu::pick_lalu_trig(m0, m1);

    let mul_set_addr = lib::mul_shiftadd::pick_mul_seta(m0, m1);
    let mul_trig = lib::mul_shiftadd::pick_mul_trig(m0, m1);

    let div_set_addr = lib::div_shiftsub::pick_div_seta(m0, m1);
    let div_trig = lib::div_shiftsub::pick_div_trig(m0, m1);

    let cmp_op_a = lib::cmp::pick_cmp_seta(m0, m1);
    let cmp_trig = lib::cmp::pick_cmp_trig(m0, m1);

    let cmpz_trig = lib::cmpz::pick_cmpz_trig(m0, m1);

    let pc_jump_final = lib::pc::pick_pc_jump(m0, m1);

    let bt_target = lib::bt::pick_bt_target(m0, m1);
    let bt_trig = lib::bt::pick_bt_trig(m0, m1);

    let lsu_set_addr = lib::lsu::pick_lsu_seta(m0, m1);
    let lsu_load_trig = lib::lsu::pick_lsu_loadtrig(m0, m1);
    let lsu_store_trig = lib::lsu::pick_lsu_storetrig(m0, m1);

    let lsu2_set_addr = lib::lsu::pick_lsu2_seta(m0, m1);
    let lsu2_load_trig = lib::lsu::pick_lsu2_loadtrig(m0, m1);
    let lsu2_store_trig = lib::lsu::pick_lsu2_storetrig(m0, m1);

    let xorshift_trig = lib::xorshift::pick_xorshift_trig(m0, m1);

    let mac_set_addr = lib::mac::pick_mac_seta(m0, m1);
    let mac_trig = lib::mac::pick_mac_trig(m0, m1);
    let mac_clear = lib::mac::pick_mac_clear(m0, m1);

    let sel_cond = lib::sel::pick_sel_cond(m0, m1);
    let sel_seta = lib::sel::pick_sel_seta(m0, m1);
    let sel_trigb = lib::sel::pick_sel_trigb(m0, m1);

    let mda_base = lib::modadd::pick_base(m0, m1);
    let mda_mask = lib::modadd::pick_mask(m0, m1);
    let mda_ptr = lib::modadd::pick_ptr(m0, m1);
    let mda_trig = lib::modadd::pick_trig(m0, m1);

    let tanh_trig = lib::tanh::pick_trig(m0, m1);

    let stack_setaddr = lib::stack_lsu::pick_seta(m0, m1);
    let stack_push = lib::stack_lsu::pick_push_trig(m0, m1);
    let stack_pop = lib::stack_lsu::pick_pop_trig(m0, m1);

    let gpo_trig = lib::gpo::pick_gpo16(m0, m1);

    let spi_out8_trig = lib::spi::pick_spi_out8(m0, m1);
    let spi_inpop_trig = lib::spi::pick_spi_inpop(m0, m1);

    let uart_out8_trig = lib::uart_in::pick_uart_out8(m0, m1);
    let uart_inpop_trig = lib::uart_in::pick_uart_inpop(m0, m1);

    let pc_jump_comb = pc_jump_final;
    let rd0          = registry.rd0;
    let rd1          = registry.rd1;

    // debug
    let r0 = registry.r0;
    let r1 = registry.r1;
    let r2 = registry.r2;
    let r3 = registry.r3;
    let r4 = registry.r4;
    let r5 = registry.r5;
    let r6 = registry.r6;
    let r7 = registry.r7;
    let r8 = registry.r8;
    let r9 = registry.r9;
    let r10 = registry.r10;
    let r11 = registry.r11;
    let r12 = registry.r12;
    let r13 = registry.r13;
    let r14 = registry.r14;
    let r15 = registry.r15;

    /*
    let state = StateDebug {
        rf_w0, rf_w1,
        r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15,

        alu_op_a, alu_trig, alu_res,
        bit_op_a, bit_trig, bit_res,
        lalu_op_a, lalu_trig, lalu_res,
        mul_set_addr, mul_trig, mul_res,
        div_set_addr, div_trig, div_res,
        cmp_op_a, cmp_trig, cmp_res,
        cmpz_trig, cmpz_res,
        pc_jump_final, bt_target, bt_trig,
        lsu_set_addr, lsu_load_trig, lsu_store_trig, lsu_res,
        lsu2_set_addr, lsu2_load_trig, lsu2_store_trig, lsu2_res,
        xorshift_trig, xorshift_res,
        tanh_trig, tanh_res,
        mac_set_addr, mac_trig, mac_clear, mac_res,
        sel_cond, sel_seta, sel_trigb, sel_res,
        mda_base, mda_mask, mda_ptr, mda_trig, mda_res,
        stack_setaddr, stack_push, stack_pop, stack_res,
        gpo_trig,
        spi_out8_trig, spi_inpop_trig,
        uart_out8_trig, uart_inpop_trig,
    };
    */

    TTA_Tick(
        pc_val,
        alu_op_a,
        alu_trig,
        alu_res,
        pc_jump_final,
        rf_w0,
        rf_w1,
        rd0,
        rd1,
        lsu_res,
        lsu_set_addr,
        lsu_store_trig,
        lsu_load_trig,
        Some(insn),
        gpo_res,
        //state
    )
}

struct StateDebug {
    // Register File
    rf_w0: Option<(uint<4>, uint<32>)>,
    rf_w1: Option<(uint<4>, uint<32>)>,
    r0: uint<32>,
    r1: uint<32>,
    r2: uint<32>,
    r3: uint<32>,
    r4: uint<32>,
    r5: uint<32>,
    r6: uint<32>,
    r7: uint<32>,
    r8: uint<32>,
    r9: uint<32>,
    r10: uint<32>,
    r11: uint<32>,
    r12: uint<32>,
    r13: uint<32>,
    r14: uint<32>,
    r15: uint<32>,

    // ALU
    alu_op_a: Option<uint<32>>,
    alu_trig: Option<(AluOp, uint<32>)>,
    alu_res: Option<uint<32>>,

    // BIT
    bit_op_a: Option<uint<32>>,
    bit_trig: Option<(BitOp, uint<32>)>,
    bit_res: Option<uint<32>>,

    // Logic ALU
    lalu_op_a: Option<uint<32>>,
    lalu_trig: Option<(LAluOp, uint<32>)>,
    lalu_res: Option<uint<32>>,

    // Multiply
    mul_set_addr: Option<uint<32>>,
    mul_trig: Option<uint<32>>,
    mul_res: Option<uint<32>>,

    // Divide
    div_set_addr: Option<uint<32>>,
    div_trig: Option<uint<32>>,
    div_res: Option<uint<32>>,

    // Compare
    cmp_op_a: Option<uint<32>>,
    cmp_trig: Option<(CmpOp, uint<32>)>,
    cmp_res: Option<uint<32>>,

    // Compare Zero
    cmpz_trig: Option<(CmpzOp, uint<32>)>,
    cmpz_res: Option<uint<32>>,

    // Control Flow
    pc_jump_final: Option<uint<10>>,
    bt_target: Option<uint<10>>,
    bt_trig: Option<uint<32>>,

    // LSU 1
    lsu_set_addr: Option<uint<32>>,
    lsu_load_trig: Option<uint<32>>,
    lsu_store_trig: Option<uint<32>>,
    lsu_res: Option<uint<32>>,

    // LSU 2
    lsu2_set_addr: Option<uint<32>>,
    lsu2_load_trig: Option<uint<32>>,
    lsu2_store_trig: Option<uint<32>>,
    lsu2_res: Option<uint<32>>,

    // Misc Units
    xorshift_trig: Option<uint<32>>,
    xorshift_res: Option<uint<32>>,

    tanh_trig: Option<uint<32>>,
    tanh_res: Option<uint<32>>,

    // MAC
    mac_set_addr: Option<uint<32>>,
    mac_trig: Option<uint<32>>,
    mac_clear: bool,
    mac_res: Option<uint<32>>,

    // Select
    sel_cond: Option<bool>,
    sel_seta: Option<uint<32>>,
    sel_trigb: Option<uint<32>>,
    sel_res: Option<uint<32>>,

    // ModAdd
    mda_base: Option<uint<32>>,
    mda_mask: Option<uint<32>>,
    mda_ptr: Option<uint<32>>,
    mda_trig: Option<uint<32>>,
    mda_res: Option<uint<32>>,

    // Stack
    stack_setaddr: Option<uint<32>>,
    stack_push: Option<uint<32>>,
    stack_pop: bool,
    stack_res: Option<uint<32>>,

    // IO
    gpo_trig: Option<uint<16>>,

    spi_out8_trig: Option<uint<8>>,
    spi_inpop_trig: bool,

    uart_out8_trig: Option<uint<8>>,
    uart_inpop_trig: bool,
}
