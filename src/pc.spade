
use lib::tta::Msg;

//============================================================
// Program Counter unit
// - PC_Val is the current PC (readable source)
// - Writing PC_Trig with a value causes a jump (next cycle)
// - If there is a conditional jump at the same time, that takes precedence
//============================================================
pub entity pc_fu(
  clk: clock, rst: bool,
  jump_to: Option<uint<10>>,
  bt: Option<uint<10>>      // read port from branch-if-true FU
) -> uint<10>
{
    reg(clk) pc: uint<10> reset(rst: 0) = match (bt, jump_to) {
        (Some(bt_target), _)    => bt_target,       // conditional branch-if-true first
        (None, Some(pc_target)) => pc_target,       // then unconditional
        (None, None)            => trunc(pc + 1)    // otherwise increment
    };
    pc
}

// Bus helper
pub fn pick_pc_jump(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<10>> {
    match m1 {
        Some(Msg::PC_Jump(a)) => Some(a),
        _ => match m0 { Some(Msg::PC_Jump(a)) => Some(a), _ => None }
    }
}
