use lib::tta::Msg;

//============================================================
// Branch if True
// - If `condition_trig` == true, jump to `jump_to`
//============================================================
pub entity bt_fu(
  clk: clock, rst: bool,
  jump_to: Option<uint<10>>,        // target address
  condition_trig: Option<uint<32>>  // if condition_trig == true, jump
) -> Option<uint<10>>
{
    reg(clk) target: Option<uint<10>> reset(rst: None) = match jump_to {
        Some(v) => Some(v),
        None => target
    };

    match (target, condition_trig) {
        (Some(v), Some(c)) => {
            if to_bool(c) { Some(v) } else { None }
        },
        (_, _) => None,
    }
}

// convert u32 to bool
fn to_bool(x: uint<32>) -> bool {
    if x == 0 {
        false
    } else {
        true
    }
}



pub fn pick_bt_target(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<10>> {
    match m1 {
        Some(Msg::BT_Target(a)) => Some(a),
        _ => match m0 { Some(Msg::BT_Target(a)) => Some(a), _ => None }
    }
}

pub fn pick_bt_trig(m0: Option<Msg>, m1: Option<Msg>) -> Option<uint<32>> {
    match m1 {
        Some(Msg::BT_Trig(a)) => Some(a),
        _ => match m0 { Some(Msg::BT_Trig(a)) => Some(a), _ => None }
    }
}
